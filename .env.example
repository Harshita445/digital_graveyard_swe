# Digital Graveyard environment variables
# Copy to .env and fill in. Never commit the real .env.

# PostgreSQL connection string.
# Local: `npm run dev:local` starts an embedded Postgres and passes its URL itself,
# so this is only used by `npm run dev` and the scripts.
DATABASE_URL="postgresql://postgres:graveyard@localhost:5433/graveyard"
# Optional direct (non-pooled) URL used for schema changes on Neon.
# DATABASE_URL_UNPOOLED=""

# GitHub personal access token (public repo read access is enough).
# Used for repo analysis, the "Suggest a Dead Repo" box and fork verification.
# Quick way: GITHUB_TOKEN=$(gh auth token)
GITHUB_TOKEN=""

# Long random strings. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""
CRON_SECRET=""

# "Continue with GitHub" sign-in. Without these two the button is greyed out
# and email sign-in still works. Register an OAuth app at
# https://github.com/settings/developers -> New OAuth App
#   Local:      Homepage http://localhost:3000
#               Callback http://localhost:3000/api/auth/github/callback
#   Production: Homepage https://digitalgraveyard.cv
#               Callback https://digitalgraveyard.cv/api/auth/github/callback
# GitHub allows one callback URL per app, so use a separate app for local dev.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Public origin used to build the OAuth redirect URI. Production: https://digitalgraveyard.cv
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Leave unset. "true" turns on offline mock data for a static demo build.
# NEXT_PUBLIC_STATIC_DEMO="true"
