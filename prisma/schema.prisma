// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String        @id @default(cuid())
  email          String        @unique
  passwordHash   String?
  githubId       String?       @unique
  githubUsername String?
  alias          String        @unique // e.g. "Digger-1042"
  credits        Int           @default(500)
  reputation     Int           @default(100)
  ghostStrikes   Int           @default(0)
  banned         Boolean       @default(false)
  createdAt      DateTime      @default(now())

  // Sessions: bumping sessionVersion signs this user out everywhere (logout, GitHub access revoked).
  sessionVersion  Int       @default(0)
  githubTokenEnc  String?   // encrypted GitHub OAuth token, used only to check access is still granted
  githubCheckedAt DateTime? // last time GitHub confirmed the token is still valid

  // Relations
  ownedProjects Project[]    @relation("ProjectOwner")
  commitments   Commitment[] @relation("TakerCommitment")
  ledgerEntries LedgerEntry[]
}

model Project {
  id              String        @id @default(cuid())
  ownerId         String
  owner           User          @relation("ProjectOwner", fields: [ownerId], references: [id])
  title           String
  description     String
  fileUrl         String        @default("/downloads/source.zip") // zip file stored on platform
  fileName        String        @default("project_archive.zip")
  stakeRequired   Int           @default(100) // stake required in credits
  techTags        String        // JSON array or comma separated string e.g. ["React","Node.js"]
  category        String        @default("Web")
  completion      Int           @default(25) // estimated starting completion %
  milestoneMode   Boolean       @default(false)
  status          String        @default("LISTED") // LISTED, PENDING_APPROVAL, ACTIVE, SUBMITTED, COMPLETED, GHOSTED_RELISTED, CANCELLED_RELISTED, REJECTED_BADFAITH, CLOSED
  reviewTimeoutAt DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // GitHub repository intelligence
  githubRepoUrl             String?
  githubRepoOwner           String?
  githubRepoName            String?
  githubDescription         String?
  githubCreatedAt           DateTime?
  githubLastUpdatedAt       DateTime?
  githubDefaultBranch       String?
  githubLicense             String?
  githubTotalCommits        Int?
  githubCommitFrequency     Float?
  githubLastCommitAt        DateTime?
  githubContributors        Int?
  githubOpenIssues          Int?
  githubClosedIssues        Int?
  githubPullRequests        Int?
  githubReleases            Int?
  githubStars               Int?
  githubForks               Int?
  githubWatchers            Int?
  githubReadmeExists        Boolean?
  githubReadmeLength        Int?
  revivalScore              Int?
  autopsyStatus             String?
  autopsyCause              String?
  autopsyLastActivity       String?
  autopsyDifficulty         String?
  peakActivityMonth         String?
  peakActivityCommits       Int?
  peakActivityContributors  Int?
  peakActivityPullRequests  Int?
  githubAnalyzedAt          DateTime?
  githubArchived            Boolean?
  githubActivity            String?   // JSON: [{ period, commits, contributors }] across the repo's whole life
  githubTopMaintainer       String?   // login of the biggest contributor
  githubMaintainerLastSeen  DateTime? // last week that contributor committed

  // Where the listing came from:
  //  DONATED    – listed by its verified owner (GitHub login matches repo owner)
  //  OPEN_GRAVE – abandoned public repo whose open-source license already allows forking
  source        String        @default("DONATED")
  handoffNote   String?       // owner's "last letter": why it stopped, what is left
  revivedRepoUrl String?      // fork that brought it back, once verified

  // What a claimer needs to know before pledging (see lib/claimRules.js)
  doneWhen       String?      // what counts as revived, in the lister's words
  starterTasks   String?      // a few concrete first jobs, one per line
  timeEstimate   String?      // WEEKEND | WEEKS | MONTH_PLUS
  claimDays      Int          @default(30) // how long a claim lasts: 14, 30 or 60
  ownerAvailable Boolean      @default(false) // donated only: owner will answer questions
  bounty         Int          @default(0)  // pledges lost by people who disappeared; paid to the next reviver

  // Relations
  commitments   Commitment[]
}

model Commitment {
  id              String      @id @default(cuid())
  projectId       String
  project         Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  takerId         String
  taker           User        @relation("TakerCommitment", fields: [takerId], references: [id])
  status          String      @default("PENDING_APPROVAL") // PENDING_APPROVAL, ACTIVE, SUBMITTED, COMPLETED, GHOSTED, CANCELLED, REJECTED_BADFAITH
  stakeLocked     Int         @default(0)
  committedAt     DateTime    @default(now())
  approvedAt      DateTime?
  ghostDeadlineAt DateTime?   // now + 14d on approval
  submittedAt     DateTime?
  submissionNotes String?
  submissionUrl   String?     // link or file path to deliverable
  forkUrl          String?   // the fork being checked for progress
  proofDueAt       DateTime? // first own commit must appear by this time (claim + 7 days)
  proofAt          DateTime? // when that first commit was seen
  requestExpiresAt DateTime? // donated only: owner must answer the request by this time
  resolvedAt      DateTime?

  // Relations
  milestones      Milestone[]
}

model Milestone {
  id           String      @id @default(cuid())
  commitmentId String
  commitment   Commitment  @relation(fields: [commitmentId], references: [id], onDelete: Cascade)
  title        String
  dueAt        DateTime
  status       String      @default("PENDING") // PENDING, MET, MISSED
  missCount    Int         @default(0)
}

model LedgerEntry {
  id                  String    @id @default(cuid())
  userId              String
  user                User      @relation(fields: [userId], references: [id])
  type                String    // STAKE_LOCK, STAKE_FORFEIT, STAKE_REFUND, REWARD_CREDIT, REP_DELTA, GHOST_STRIKE
  amount              Int       // positive or negative
  relatedProjectId    String?
  relatedCommitmentId String?
  notes               String?
  createdAt           DateTime  @default(now())

  // Note: APPEND-ONLY, application layer exposes no update or delete operations on this table
}
